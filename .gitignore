# macOS writes Finder, archive and volume metadata alongside project files.
# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100/
.fseventsd/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB/
.AppleDesktop/
Network Trash Folder/
Temporary Items/
.apdisk

# Keep local environments, credentials, and generated files out of the shared repository.
.idea/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
!.env.example
/verification/
